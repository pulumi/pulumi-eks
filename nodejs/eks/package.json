{
    "name": "@pulumi/eks",
    "version": "${VERSION}",
    "description": "Pulumi Amazon Web Services (AWS) EKS Components.",
    "license": "Apache-2.0",
    "bin": "bin/cmd/provider/index.js",
    "keywords": [
        "pulumi",
        "aws",
        "eks"
    ],
    "scripts": {
        "format": "oxfmt --write .",
        "lint": "oxlint --deny-warnings .",
        "test": "jest",
        "tsc": "node ./node_modules/@typescript/native/bin/tsc",
        "dedupe-deps": "yarn-deduplicate",
        "check-duplicate-deps": "yarn-deduplicate --fail",
        "build": "SCHEMA=../../provider/cmd/pulumi-resource-eks/schema-embed.json ./scripts/build.sh"
    },
    "homepage": "https://pulumi.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/pulumi/pulumi-eks.git"
    },
    "bugs": "https://github.com/pulumi/pulumi-eks/issues",
    "dependencies": {
        "@iarna/toml": "^3.0.0",
        "@pulumi/aws": "7.25.0",
        "@pulumi/kubernetes": "4.19.0",
        "@pulumi/pulumi": "^3.143.0",
        "https-proxy-agent": "^7.0.6",
        "ipaddr.js": "^2.2.0",
        "js-yaml": "^4.1.0",
        "netmask": "^2.0.2",
        "semver": "^7.3.7",
        "which": "^1.3.1"
    },
    "devDependencies": {
        "@babel/core": "^7.17.9",
        "@babel/preset-env": "^7.23.9",
        "@babel/preset-typescript": "^7.23.3",
        "@types/jest": "^30.0.0",
        "@types/js-yaml": "^4.0.5",
        "@types/netmask": "^1.0.30",
        "@types/node": "^24",
        "@types/semver": "^7.3.10",
        "@types/which": "^1.3.1",
        "@yao-pkg/pkg": "6.22.0",
        "@typescript/native": "npm:typescript@7.0.2",
        "babel-jest": "^30.5.1",
        "jest": "^30.5.1",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.81.0",
        "yarn-deduplicate": "^6.0.2"
    },
    "pulumi": {
        "resource": true
    },
    "jest": {
        "modulePathIgnorePatterns": [
            "/bin/"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/bin/"
        ],
        "transformIgnorePatterns": [
            "node_modules/(?!(ip-bigint))"
        ]
    }
}
