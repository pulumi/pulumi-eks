{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "no-empty-file": "off",
        "no-param-reassign": ["error", { "props": true }],
        "no-unused-vars": "off"
    },
    "ignorePatterns": ["bin/**"]
}
