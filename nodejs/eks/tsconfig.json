{
    "compilerOptions": {
        "outDir": "bin",
        "target": "ES2022",
        "lib": ["ES2022"],
        // ComponentResource initializes output properties when rehydrating resource references.
        "useDefineForClassFields": false,
        // TypeScript 6 no longer loads visible @types packages automatically.
        "types": ["node", "jest"],
        "module": "commonjs",
        // The provider is emitted as CommonJS and packaged into a stand-alone executable.
        "moduleResolution": "bundler",
        "declaration": true,
        "sourceMap": true,
        "stripInternal": true,
        "experimentalDecorators": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "forceConsistentCasingInFileNames": true,
        "strictNullChecks": true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["./**/*.ts"],
    "exclude": ["node_modules", "bin"]
}
